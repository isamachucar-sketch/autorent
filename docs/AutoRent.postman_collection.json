                "api",
                "clientes",
                "{{clientePrecargadoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Es Laura Gómez\", () => pm.expect(j.nombre).to.eql(\"Laura Gómez\"));",
                  "pm.test(\"Documento 1043987654\", () => pm.expect(j.documento).to.eql(\"1043987654\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Precargado - Alquiler 1: 5 días, ACTIVO, valor calculado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alquileres/{{alquilerPrecargadoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "alquileres",
                "{{alquilerPrecargadoId}}"
              ]
            }
