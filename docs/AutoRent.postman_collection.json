          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Cliente 1 y auto 1\", () => { pm.expect(j.clienteId).to.eql(Number(pm.collectionVariables.get(\"clientePrecargadoId\"))); pm.expect(j.autoId).to.eql(Number(pm.collectionVariables.get(\"autoPrecargadoId\"))); });",
                  "pm.test(\"5 días y estado ACTIVO\", () => { pm.expect(j.cantidadDias).to.eql(5); pm.expect(j.estado).to.eql(\"ACTIVO\"); });",
                  "pm.test(\"valorTotal = 180000 x 5 = 900000\", () => pm.expect(Number(j.valorTotal)).to.eql(900000));",
                  "pm.test(\"valorTotalConDeposito = 900000 + 600000 = 1500000\", () => pm.expect(Number(j.valorTotalConDeposito)).to.eql(1500000));"
                ]
              }
            }
          ]
        },
